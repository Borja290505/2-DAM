<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#E8F5E9"
    tools:context=".ContadorActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="App 2: Contador de Clics"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvValorContador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="64sp"
        android:textStyle="bold"
        android:textColor="#1B5E20"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <Button
            android:id="@+id/btnDecrementar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="- 1"
            android:backgroundTint="#C62828"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnResetearContador"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reset"
            android:backgroundTint="#757575"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnIncrementar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ 1"
            android:backgroundTint="#2E7D32"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnVolverDashboard2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Volver al Dashboard"
        android:backgroundTint="#2E7D32"/>

</LinearLayout>