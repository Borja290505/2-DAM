QPushButton{
    border-style: solid;
    border-width: 2px;
    border-color: red;
    border-radius: 5px;
    color: red
}

QPushButton#pushButton_2{
    border-style: solid;
    border-width: 2px;
    border-color: green;
    border-radius: 5px;
    color: green;

}

QLineEdit{
    min-width: 100px;
    min-height: 20px;
    max-width: 100px;
    max-height: 20px;
    border-style: solid;
    border-width: 2px;
    border-color: lightgray;
    border-radius: 5px;
    background-color: lightgray;
}

QLabel{
    color: blue;
    font-weight: bold;
    font-size: 14px;
}